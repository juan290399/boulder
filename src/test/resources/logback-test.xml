<?xml version="1.0" encoding="UTF-8"?>
<!--
    Configuración de Logback para las pruebas. Reemplaza a logback-spring.xml
    mientras corre el test: todo va a la consola y nada a logs/. Sin esto, las
    pruebas escribían intentos de login y cambios de contraseña simulados en la
    bitácora de seguridad real, donde no se distinguen de los verdaderos.
-->
<configuration>

    <appender name="CONSOLA" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.hibernate.SQL" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLA"/>
    </root>

</configuration>
