<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <springProperty name="LOG_PATH" source="boulder.logs.directorio" defaultValue="logs"/>

    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss} [%thread] [%X{peticion:--}] %-5level %logger{36} - %msg%n
            </pattern>
        </encoder>

    </appender>

    <appender name="FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_PATH}/boulder.log</file>

        <rollingPolicy
            class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">

            <fileNamePattern>
                ${LOG_PATH}/boulder-%d{yyyy-MM-dd}.%i.log
            </fileNamePattern>

            <maxFileSize>10MB</maxFileSize>

            <maxHistory>30</maxHistory>

        </rollingPolicy>

        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss} [%thread] [%X{peticion:--}] %-5level %logger{36} - %msg%n
            </pattern>
        </encoder>

    </appender>

    <!--
        Bitácora estructurada: la misma información en JSON (formato ECS), una
        línea por evento, con nivel, logger, hilo y el id de la petición del MDC.
        Es la que leen las herramientas (jq, Filebeat, Loki) sin expresiones
        regulares; boulder.log queda para leerla a ojo.
    -->
    <appender name="JSON"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_PATH}/boulder.json</file>

        <rollingPolicy
            class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/boulder-%d{yyyy-MM-dd}.%i.json</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
        </rollingPolicy>

        <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
            <format>ecs</format>
            <charset>UTF-8</charset>
        </encoder>

    </appender>

    <!--
        Bitácora de seguridad: inicios de sesión correctos, fallidos y bloqueados.
        Va a su propio archivo y se conserva 90 días, más que la bitácora general,
        porque es la que se revisa después de un incidente. Nunca contiene
        contraseñas ni tokens: el filtro de login solo registra usuario, IP y motivo.
    -->
    <appender name="SEGURIDAD"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <file>${LOG_PATH}/seguridad.log</file>

        <rollingPolicy
            class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/seguridad-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>90</maxHistory>
        </rollingPolicy>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%X{peticion:--}] %-5level %msg%n</pattern>
        </encoder>

    </appender>

    <logger name="com.boulder.boulder.seguridad" level="INFO" additivity="false">
        <appender-ref ref="SEGURIDAD"/>
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="JSON"/>
    </logger>

    <root level="INFO">

        <appender-ref ref="CONSOLE"/>

        <appender-ref ref="FILE"/>

        <appender-ref ref="JSON"/>

    </root>

</configuration>