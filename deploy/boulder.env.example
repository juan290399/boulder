# Variables de entorno de producción (copiar a /etc/boulder/boulder.env, permisos 600).
SPRING_PROFILES_ACTIVE=prod
PORT=8080

DB_URL=jdbc:postgresql://localhost:5432/boulder_db
DB_USER=boulder
DB_PASSWORD=cambiar
DB_POOL=10

# Clave HMAC-SHA256 del JWT: al menos 32 caracteres aleatorios.
# Generar con: openssl rand -base64 48
JWT_SECRET=cambiar

BOULDER_FOTOS=/var/lib/boulder/fotos
BOULDER_LOGS=/var/log/boulder
