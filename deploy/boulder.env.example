# Variables de entorno de producción (copiar a /etc/boulder/boulder.env, permisos 600).
SPRING_PROFILES_ACTIVE=prod
PORT=8080

DB_URL=jdbc:postgresql://localhost:5432/boulder_db
DB_USER=boulder
DB_PASSWORD=cambiar
DB_POOL=10

# Clave HMAC-SHA256 del JWT: al menos 32 caracteres aleatorios.
# Generar con: openssl rand -base64 48
JWT_SECRET=cambiar

BOULDER_FOTOS=/var/lib/boulder/fotos
BOULDER_LOGS=/var/log/boulder

# Opcionales: espacio libre mínimo del almacén de fotos para la salud (MB) y
# horarios de las tareas de mantenimiento de la aplicación (cron de Spring).
#BOULDER_FOTOS_MINIMOLIBREMB=1024
#BOULDER_MANTENIMIENTO_CRON_TEMPORALES=0 30 3 * * *
#BOULDER_MANTENIMIENTO_CRON_DISPOSITIVOS=0 */15 * * * *
